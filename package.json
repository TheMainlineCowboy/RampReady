{
  "name": "rampready",
  "version": "0.1.7",
  "private": true,
  "description": "RampReady pushback training simulator prototype.",
  "type": "module",
  "scripts": {
    "materialize:authored-aircraft": "node scripts/materialize-authored-aircraft-clean.mjs",
    "materialize:standup-tug": "node scripts/materialize-standup-tug-runtime.mjs",
    "materialize:phx-terminal4": "node scripts/materialize-terminal4-package-first.mjs",
    "materialize:kphx-ground": "node scripts/materialize-kphx-ground.mjs",
    "prepare:source-only-runtime": "node scripts/patch-source-only-runtime.mjs",
    "materialize:source-runtime": "npm run materialize:authored-aircraft && npm run materialize:standup-tug && npm run materialize:phx-terminal4 && npm run materialize:kphx-ground && npm run prepare:source-only-runtime",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run materialize:source-runtime && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "verify": "node scripts/verify-source-assets-only.mjs",
    "build:checked": "npm run verify && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0"
  },
  "devDependencies": {}
}
